# Metin Karşılaştırma — ayarlar
# Kullanım: bu dosyayı .env olarak kopyalayın, düzenleyin, ardından `docker compose up -d` çalıştırın.
# Boş bırakılan değerler için uygulama varsayılanı kullanılır.

# ---------- Ağ ----------
# Konteynerin bağlanacağı adres. 127.0.0.1 = yalnızca bu makineden erişilebilir (Cloudflare Tunnel için).
BIND_ADDRESS=127.0.0.1
# Dışarıya açılan port.
HOST_PORT=7080

# ---------- Site ----------
# Başlık (sekme adı ve sayfa üstü). Boşsa dile göre "Metin Karşılaştırma" / "Text Compare".
SITE_TITLE=
# Başlığın yanındaki açıklama. Boşsa dile göre varsayılan gizlilik açıklaması.
SITE_TAGLINE=
# Sayfa altı metni. Boşsa "Kayıt tutulmaz · Çerez yok · Analitik yok".
SITE_FOOTER=

# ---------- Varsayılan tercihler ----------
# Ziyaretçi sayfada kendisi bir şey seçtiyse, onun seçimi bu değerlerden önceliklidir.
# Arayüz dili: tr | en
DEFAULT_LANG=tr
# Tema: auto (sistem ayarı) | light | dark
DEFAULT_THEME=auto
# Görünüm: split (yan yana) | unified (tek sütun)
DEFAULT_VIEW=split
# Değişmeyenleri gizle: true | false
DEFAULT_HIDE_UNCHANGED=false
# Gizlerken bırakılacak bağlam satırı: 0 | 3 | 5 | 10 | 20
DEFAULT_CONTEXT=5
